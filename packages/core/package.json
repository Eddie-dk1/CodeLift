{
  "name": "@codelift/core",
  "version": "0.4.0-beta.0",
  "private": true,
  "description": "CodeLift analysis, extraction planning, export, and verification engine",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run ../../packages/core/test"
  },
  "dependencies": {
    "typescript-compat": "npm:@typescript/typescript6@^6.0.0"
  }
}
